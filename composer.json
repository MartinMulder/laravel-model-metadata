{
    "name": "martinmulder/laravel-model-metadata",
    "description": "Attach flexible, typed, polymorphic metadata to any Eloquent model, with class- or scope-based required-field schemas and an optional FilamentPHP v5 integration.",
    "type": "library",
    "keywords": ["laravel", "eloquent", "metadata", "filament"],
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Mulder",
            "email": "martin@serioussecurity.nl"
        }
    ],
    "require": {
        "php": "^8.3 || ^8.4",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MartinMulder\\LaravelModelMetadata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MartinMulder\\LaravelModelMetadata\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "filament/filament": "Required to use the MetadataRelationManager within FilamentPHP v5 panels."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MartinMulder\\LaravelModelMetadata\\LaravelModelMetadataServiceProvider"
            ]
        }
    }
}
